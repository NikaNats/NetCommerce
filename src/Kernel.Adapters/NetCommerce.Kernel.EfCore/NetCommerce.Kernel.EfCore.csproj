    <PackageId>NetCommerce.Kernel.EfCore</PackageId>
    <Description>Entity Framework Core adapter - Base DbContext, repositories, value converters, resilient transactions. PostgreSQL-optimized.</Description>
    <PackageTags>EFCore;EntityFramework;PostgreSQL;Repository;Persistence</PackageTags>
