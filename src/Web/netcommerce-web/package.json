{
  "name": "netcommerce-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen:api": "openapi-typescript \"${API_BASE_URL:-http://localhost:5000}/openapi/v1.json\" -o ./src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "openapi-typescript": "7.6.1",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  }
}
