{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Storage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "netcommerce",
    "CdnBaseUrl": "http://localhost:9000/netcommerce"
  },
  "Auth": {
    "AdminElevated": {
      "ApiKey": "dev-only-key-minimum-32-chars-here!",
      "MaxAuthAgeMinutes": 60,
      "SecurityMode": "DevelopmentOnly"
    }
  },
  "ReservationCleanup": {
    "Enabled": true,
    "IntervalMs": 60000,
    "BatchSize": 100
  },
  "ProblemDetails": {
    "BaseUri": "http://localhost:5000/errors",
    "IncludeStackTrace": true,
    "IncludeExceptionDetails": true
  }
}
