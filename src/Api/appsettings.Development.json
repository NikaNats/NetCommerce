{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Json.JsonFormatter, Serilog"
          }
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "formatter": {
            "type": "Serilog.Formatting.Json.JsonFormatter, Serilog"
          }
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=netcommerce;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5001", "https://localhost:3000" ]
  },
  "Storage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "netcommerce",
    "CdnBaseUrl": "http://localhost:9000/netcommerce"
  },
  "Stripe": {
    "SecretKey": "sk_test_YOUR_STRIPE_SECRET_KEY",
    "PublishableKey": "pk_test_YOUR_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "whsec_YOUR_STRIPE_WEBHOOK_SECRET",
    "TestMode": true,
    "AllowTestModeInProduction": false
  },
  "Auth": {
    "AdminElevated": {
      "ApiKey": "dev-only-key-minimum-32-chars-here!",
      "MaxAuthAgeMinutes": 60,
      "SecurityMode": "DevelopmentOnly"
    }
  },
  "ReservationCleanup": {
    "Enabled": true,
    "IntervalMs": 60000,
    "BatchSize": 100
  },
  "ProblemDetails": {
    "BaseUri": "http://localhost:5000/errors",
    "IncludeStackTrace": true,
    "IncludeExceptionDetails": true
  }
}
