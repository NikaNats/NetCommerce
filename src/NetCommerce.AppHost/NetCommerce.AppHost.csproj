<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3"/>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>netcommerce-apphost</UserSecretsId>
    <!--
      No packages lock file for the dev-time orchestrator host: Aspire pulls
      OS-specific transitive packages (e.g. Aspire.Dashboard.Sdk.linux-x64 vs
      win-x64), so a committed lock can never verify on all developer/CI hosts
      (NU1004). The shippable projects keep their locks; this host is never deployed.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost"/>
    <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
    <PackageReference Include="Aspire.Hosting.Redis"/>
    <PackageReference Include="Keycloak.AuthServices.Aspire.Hosting"/>
    <PackageReference Include="Aspire.Hosting.Azure.Storage"/>
    <PackageReference Include="Aspire.Hosting.Seq"/>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Meilisearch"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\NetCommerce.Api.csproj"/>
  </ItemGroup>

</Project>
