  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "The .NET API is the sole token authority: /auth/token, /auth/refresh, /auth/logout, /auth/session (AuthEndpoints.cs)",
        "Next.js is a BFF and session custodian — it holds tokens server-side and never forwards them to the browser"
      ]
    },
    {
      "dot": "emerald",
      "title": "Eight bounded contexts",
      "items": [
        "Basket, Catalog, Finance, Inventory, Media, Ordering, Payments, Shipping — one PostgreSQL schema each",
        "Communication is asynchronous through Wolverine, never direct module-to-module calls"
      ]
    },
    {
      "dot": "cyan",
      "title": "Real-time and search",
      "items": [
        "UseSignalR() + ToSignalR() deliver order status to the browser (MessagingExtensions.cs:88,94)",
        "MeiliSearch is a read model projected from Catalog events, never written synchronously"
      ]
    }
  ]
