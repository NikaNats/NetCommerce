{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Checkout to Real-Time Order Progress",
    "output": "docs/diagrams/checkout-sequence.html",
    "viewBox": [960, 680],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "locale": "en"
  },
  "participants": [
    { "id": "browser", "type": "external", "label": "Browser", "sublabel": "opaque cookie" },
    { "id": "web", "type": "frontend", "label": "Next.js BFF", "sublabel": "server action" },
    { "id": "api", "type": "backend", "label": ".NET API", "sublabel": "token authority" },
    { "id": "pg", "type": "database", "label": "PostgreSQL", "sublabel": "orders schema" },
    { "id": "bus", "type": "messagebus", "label": "Wolverine", "sublabel": "outbox + saga" },
    { "id": "hub", "type": "messagebus", "label": "SignalR hub", "sublabel": "/api/messages" },
    { "id": "inv", "type": "database", "label": "Inventory", "sublabel": "reservation" },
    { "id": "pay", "type": "backend", "label": "Payments", "sublabel": "Stripe adapter" }
  ],
  "segments": [
      { "from": 150, "to": 300, "label": "Place order" },
      { "from": 310, "to": 480, "label": "Saga runs" },
      { "from": 480, "to": 600, "label": "Progress to browser" }
    ],
    "messages": [
      { "id": "submit", "from": "browser", "to": "web", "y": 170, "label": "placeOrderAction", "variant": "emphasis", "note": "checkout/actions.ts:55" },
      { "id": "idem", "from": "browser", "to": "web", "y": 210, "label": "X-Idempotency-Key", "variant": "security", "note": "actions.ts:81-82 minted once per page load" },

      { "id": "post-order", "from": "web", "to": "api", "y": 260, "label": "POST /api/v1/orders", "variant": "security", "note": "OrderEndpoints.cs MapPost(\"/\"); actions.ts:47" },
      { "id": "persist", "from": "api", "to": "pg", "y": 310, "label": "insert + outbox", "variant": "dashed", "note": "outbox, same tx" },

      { "id": "saga-start", "from": "api", "to": "bus", "y": 350, "label": "StartOrderFulfillmentCommand", "variant": "dashed", "note": "State.cs:131" },
      { "id": "reserve", "from": "bus", "to": "inv", "y": 390, "label": "ReserveInventoryCommand", "variant": "dashed", "note": "State.cs:155 SELECT...FOR UPDATE" },
      { "id": "reserved", "from": "inv", "to": "bus", "y": 435, "label": "InventoryReserved", "variant": "default", "note": "HappyPath.cs:23" },
      { "id": "request-pay", "from": "bus", "to": "pay", "y": 470, "label": "RequestPaymentCommand", "variant": "dashed", "note": "HappyPath.cs:65 webhook-first" },

      { "id": "open-tracker", "from": "browser", "to": "hub", "y": 490, "label": "connect /api/messages", "variant": "emphasis", "note": "use-order-saga.ts:189" },
            { "id": "subscribe", "from": "hub", "to": "browser", "y": 520, "label": "ReceiveMessage", "variant": "security", "note": "use-order-saga.ts:219 ReceiveMessage (not per-event channel)" },
            { "id": "push", "from": "hub", "to": "browser", "y": 550, "label": "order_status_changed", "variant": "emphasis", "note": "MessagingExtensions.cs:94 Publish(IOrderNotification -> ToSignalR())" },
            { "id": "reconcile", "from": "browser", "to": "web", "y": 525, "label": "GET /api/bff/orders/{id}", "variant": "dashed", "note": "use-order-saga.ts:141 BFF proxy" }
    ],
  "cards": [
    {
      "dot": "emerald",
      "title": "One authoritative path",
      "items": [
        "POST /api/v1/orders is the only route that turns a basket into an order (actions.ts:47)",
        "The idempotency key is minted once per page load (actions.ts:81-82), so a double submit cannot double-charge"
      ]
    },
    {
      "dot": "rose",
      "title": "The browser never sees a token",
      "items": [
        "The BFF holds the bearer server-side; the browser carries only an opaque httpOnly session cookie",
        "receiveMessage is the real client API - Wolverine pushes CloudEvents through ReceiveMessage, not a per-event channel name"
      ]
    }
  ]
}