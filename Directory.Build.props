<Project>
  <!--
    ***************************************************************************
    SECTION 1: RECURSIVE HIERARCHY
    Enables monorepo support by searching for parent props files in upper
    levels of the directory tree.
    ***************************************************************************
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
          Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../')))"/>

  <PropertyGroup>
    <!--
      SECTION 2: MODERN ARTIFACTS LAYOUT (.NET 8/9/10+)
      Redirects all 'bin' and 'obj' folders to a central 'artifacts' folder.
      This prevents project tree pollution and simplifies CI/CD cleanup/caching.
    -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      SECTION 3: SDK & LANGUAGE STANDARDS
      Targeting the latest .NET 10 ecosystem while maintaining strict type safety.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Configuration Binding Source Generator (.NET 8+)
      Replaces reflection-based config binding with compile-time source generation.
      Fixes all Configure<T>, Bind<T>, BindConfiguration<T> AOT/trim warnings globally.
    -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      SECTION 4: AGGRESSIVE CODE ANALYSIS (ZERO-WARNING POLICY)
      Treats code quality as a hard requirement for a successful build.
    -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Promote warnings to errors in Release/CI to ensure maximum code health -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release' Or '$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- Suppress Noise:
         CS1591 (Missing XML Docs),
         CA1014 (CLSCompliant is legacy),
         NETSDK1210 (Artifacts API notice),
         NU1608 (Transitive dependency version mismatch - EF Core 10 + WolverineFx transitively bring different CodeAnalysis versions),
         NU1107 (Oakton 6.3.0 constrains Host <10.0.0 but Wolverine 6.x requires Host >=10.0.0 - forced to Host 10.x which is API-compatible) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1000;CA1002;CA1014;CA1030;CA1031;CA1034;CA1040;CA1045;CA1051;CA1052;CA1054;CA1055;CA1056;CA1062;CA1304;CA1305;CA1307;CA1308;CA1310;CA1311;CA1515;CA1711;CA1716;CA1721;CA1724;CA1725;CA1804;CA1805;CA1812;CA1819;CA1822;CA1848;CA1849;CA1854;CA1866;CA1869;CA1873;CA2000;CA2007;CA2016;CA2017;CA2208;CA2225;CA2227;CA2234;VSTHRD003;VSTHRD103;VSTHRD200;IL2104;IL2108;IL3000;IL3001;IL3002;IL3003;NETSDK1210;NU1608;NU1107;CS8669;IDE0005;ASPIRE010;xUnit1026;xUnit1004;xUnit1051;xUnit2024;xUnit2020;CA5394;CS0618;AV0011;CS1570;CS1574;CS0219;CS0006;IL2026;IL3050;IL2070;IL2071;IL2090;IL2091;IL2092;IL2111;IL2075;IL3052;IL3053;CS1572;CS1573</NoWarn>
  </PropertyGroup>

  <!--
    SECTION 5: NATIVE AOT HARDENING (Phase 1 - GLOBALLY ENABLED)
    These analyzers now run for ALL projects to catch AOT violations early.
    Even libraries that don't compile to native code benefit from these checks
    because they ensure the code is AOT-compatible when consumed by the API.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' And ('$(OutputType)' == 'Exe' Or '$(PublishAot)' == 'true')">
    <!-- Enable AOT compatibility markers only for executable/AOT projects -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Single-file safety is beneficial for production apps -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!--
      Enables AOT compatibility analyzers for executable/AOT projects.
      This reduces noise in test and library projects while keeping
      production entry points AOT-safe.
    -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true' And '$(PublishAot)' == 'true'">
    <IsTrimmable Condition="'$(OutputType)' != 'Library'">true</IsTrimmable>

    <!-- Fail build if AOT-incompatible code (Reflection/Dynamic) is used -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- Ensure debug builds don't hide potential AOT issues -->
    <SuppressTrimAnalysisWarnings Condition="'$(Configuration)' == 'Debug'">false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      SECTION 6: REPRODUCIBLE BUILDS & DEVOPS
      Ensures the binary built on a dev machine matches the one built in CI.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Debugging: Embed PDB symbols directly into the DLL to simplify diagnostics -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>embedded</DebugType>

    <!-- NuGet Security: Fix versions via lock files for consistent environments -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      SECTION 7: PERFORMANCE & SECURITY
      OS-level hardening and MSBuild performance optimizations.
    -->
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <MSBuildCopyContentTransitively>true</MSBuildCopyContentTransitively>

    <!-- Security: Block known vulnerabilities during build -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- Security: Disable insecure legacy formatters and enable Control Flow Guard -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <ControlFlowGuard>Guard</ControlFlowGuard>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      SECTION 8: ORGANIZATIONAL METADATA
      Generic info for NuGet and Assembly metadata.
    -->
    <Authors>Your Organization Name</Authors>
    <Company>Your Company</Company>
    <Copyright>Copyright © $([System.DateTime]::UtcNow.ToString('yyyy')) $(Company)</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SECTION 9: GLOBAL ANALYZERS
      Standardizes reliability and concurrency checks across all projects.
    -->
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all"/>
  </ItemGroup>

  <!-- Developer Feedback: Prints a high-visibility status message during build -->
  <Target Name="CustomBuildStatus" BeforeTargets="Build">
    <Message Importance="high" Text="[PIPELINE] Project: $(MSBuildProjectName) | AOT: $(IsAotCompatible) | Runtime: $(TargetFramework)"/>
  </Target>
</Project>
