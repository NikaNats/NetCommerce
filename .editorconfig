# ============================================================
# SOTA .NET EditorConfig (2024-2025 Edition)
# Baseline: dotnet/runtime | Focus: Perf, AOT, C# 12/13
# ============================================================

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,vbproj,props,targets,config,nuspec}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.cs]
###############################
# Analyzer Categories (CA/IDE)#
###############################
# Default all analyzers to warning
dotnet_analyzer_diagnostic.severity = warning

# Category specific overrides
# Style is suggestion-only: compiler gates correctness (CA/IL/CS), `dotnet format` gates style.
# Promoting style to errors is what forced the original blanket <NoWarn> suppression.
dotnet_analyzer_diagnostic.category-Security.severity = error
dotnet_analyzer_diagnostic.category-Reliability.severity = warning
dotnet_analyzer_diagnostic.category-Performance.severity = warning
dotnet_analyzer_diagnostic.category-Design.severity = warning
dotnet_analyzer_diagnostic.category-Style.severity = suggestion
dotnet_analyzer_diagnostic.category-CodeQuality.severity = warning

# Critical Individual Rules (High Impact)
dotnet_diagnostic.CA2007.severity = none # CA2007: ConfigureAwait is noise in modern .NET
dotnet_diagnostic.CA2016.severity = warning # Forward CancellationToken
# CA1031 is suggestion everywhere EXCEPT Domain/Application (section 4 below, error):
# background jobs, storage/gateway adapters and alert fan-out already implement the
# OCE-first + boundary-catch pattern by design (verified: ReservationCleanupJob,
# GracePeriodManagerService); forcing per-SDK exception enumeration there would
# weaken resilience, not strengthen it. Suggestion keeps new sites IDE-visible.
dotnet_diagnostic.CA1031.severity = suggestion
# CA1848/CA1873 are suggestion (perf backlog, IDE-visible): the 100+ existing call sites are
# cold paths; LoggerMessage migration is enforced for new hot-path code in review instead.
dotnet_diagnostic.CA1848.severity = suggestion # Use LoggerMessage pattern (Perf)
dotnet_diagnostic.CA1873.severity = suggestion # Avoid expensive logging args (Perf)
dotnet_diagnostic.CA1856.severity = error # ConstantExpected misuse
dotnet_diagnostic.CA2264.severity = warning # ThrowIfNull on non-nullable values
dotnet_diagnostic.CA2252.severity = error # Preview features must be opted in

# Trimming / Native AOT readiness
dotnet_diagnostic.IL2026.severity = warning # RequiresUnreferencedCode
dotnet_diagnostic.IL3050.severity = warning # RequiresDynamicCode

# ==============================================================================
# Path-Scoped Diagnostic Overrides (surgical scoping - generated code must not
# block the pipeline; domain hot paths stay zero-tolerance via .globalconfig)
# ==============================================================================

# 1. EF Core Migrations (generated one-shot DDL, not hot paths)
[src/**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.IL2026.severity = none
dotnet_diagnostic.IL3050.severity = none

# 2. Wolverine pre-generated handlers (static codegen output)
[src/**/Internal/Generated/**/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# 3. Test suites (assertion patterns, mocks, fixture setups)
[tests/**/*.cs]
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1869.severity = none
dotnet_diagnostic.IL2026.severity = none
dotnet_diagnostic.IL3050.severity = none
# CS8602 deref-after-ShouldNotBeNull is the standard Shouldly idiom, invisible to flow
# analysis; NREs in tests fail loudly at runtime. Argument-null (CS8604) stays error.
dotnet_diagnostic.CS8602.severity = suggestion

# 4. Domain & Application handlers (zero-tolerance for leaks & concurrency;
# CA1848 stays suggestion here too — LoggerMessage migration is backlog, not gate)
[src/**/*.{Domain,Application}/**/*.cs]
dotnet_diagnostic.CA2000.severity = error
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.CA1031.severity = error
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

# 5. (Retired: CA1031 boundary scoping is now covered by the [*.cs] suggestion
# above + the Domain/Application error in section 4. Kept as placeholder so section
# numbering stays stable for future path-scoped rules.)

# 6. ServiceDefaults plumbing (health/chaos/diagnostics log rarely and never on
# hot paths; LoggerMessage migration tracked as tech-debt, not a build gate.
# NOTE: Roslyn requires a separate root-level section — `dir/**/*.cs` only
# matches files in subdirectories, not files directly in `dir`.)
[src/NetCommerce.ServiceDefaults/**/*.cs]
dotnet_diagnostic.CA1848.severity = suggestion

[src/NetCommerce.ServiceDefaults/*.cs]
dotnet_diagnostic.CA1848.severity = suggestion

# 7. Roslyn source-generator & build outputs (never analyze generated code)
[*.{g,i}.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.IDE0240.severity = none
dotnet_diagnostic.IDE0036.severity = none

[**/obj/**]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[**/artifacts/**]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

###############################
# Naming (dotnet/runtime)     #
###############################
# Constants -> PascalCase
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case_style
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Static fields -> s_camelCase
dotnet_naming_rule.static_fields_prefix.severity = warning
dotnet_naming_rule.static_fields_prefix.symbols = static_fields
dotnet_naming_rule.static_fields_prefix.style = s_prefix_camel
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_symbols.static_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_style.s_prefix_camel.required_prefix = s_
dotnet_naming_style.s_prefix_camel.capitalization = camel_case

# Private/internal fields -> _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

###############################
# Modern C# Styles            #
###############################
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
csharp_prefer_simple_using_statement = true:warning

# var usage (Clean but safe)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

###############################
# Formatting (Allman)         #
###############################
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true

csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

csharp_space_around_binary_operators = before_and_after
csharp_space_after_keywords_in_control_flow_statements = true
