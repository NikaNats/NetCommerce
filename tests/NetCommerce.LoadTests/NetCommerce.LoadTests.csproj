<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!-- AspNetCore server types (ForwardedHeadersOptions for the load-test proxy trust).
       The SDK-style test project otherwise lacks the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Replaced InMemory with real PostgreSQL for accurate concurrency testing -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="NBomber" />
    <PackageReference Include="NBomber.Http" />

    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <!-- WebApplicationFactory + TestServer/TestHost for the self-bootstrapping fixture -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Oakton entry-point interop flag (JasperFxEnvironment.AutoStartHost) for WAF boot -->
    <PackageReference Include="JasperFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\NetCommerce.Api.csproj" />
    <ProjectReference Include="..\..\src\Inventory\Inventory.Domain\Inventory.Domain.csproj" />
    <ProjectReference Include="..\..\src\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Kernel\NetCommerce.Kernel.Core\NetCommerce.Kernel.Core.csproj" />
    <ProjectReference Include="..\..\src\Kernel.Adapters\NetCommerce.Kernel.EfCore\NetCommerce.Kernel.EfCore.csproj" />
    <ProjectReference Include="..\..\src\Domain.Shared\NetCommerce.Domain.Shared\NetCommerce.Domain.Shared.csproj" />
  </ItemGroup>

</Project>
